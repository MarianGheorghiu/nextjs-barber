# Copy to .env.local. Use the NEW Supabase project, never the legacy database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Web Push key; the PRIVATE key belongs only in Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=
# Explicit browser-local preview; set false for a real deployment.
VITE_DEMO_MODE=true
